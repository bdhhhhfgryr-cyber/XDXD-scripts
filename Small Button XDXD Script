local function removeESP(other)
	local data = espObjects[other]

	if data then
		if data.highlight then
			data.highlight:Destroy()
		end

		if data.billboard then
			data.billboard:Destroy()
		end

		espObjects[other] = nil
	end
end

local function validCharacter(char)
	if not char then
		return false
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	return hum and hrp and hum.Health > 0
end

local function createESP(other)
	if other == player or espObjects[other] then
		return
	end

	local char = other.Character

	if not validCharacter(char) then
		return
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")

	if not hrp then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "MegaXDXD_ESP"
	highlight.Adornee = char
	highlight.FillColor = Color3.fromRGB(255, 0, 120)
	highlight.FillTransparency = 0.65
	highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "MegaXDXD_Name"
	billboard.Adornee = hrp
	billboard.Size = UDim2.fromOffset(220, 45)
	billboard.StudsOffset = Vector3.new(0, 3.5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = MAX_AIM_DISTANCE
	billboard.Parent = char

	local label = Instance.new("TextLabel")
	label.Name = "PlayerName"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = other.DisplayName .. "  @" .. other.Name
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.Parent = billboard

	espObjects[other] = {
		highlight = highlight,
		billboard = billboard,
		label = label
	}
end

local function refreshESP()
	if not espEnabled then
		for other in pairs(espObjects) do
			removeESP(other)
		end
		return
	end

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			if not espObjects[other] then
				createESP(other)
			end
		end
	end

	for other in pairs(espObjects) do
		if not other.Parent then
			removeESP(other)
		elseif not validCharacter(other.Character) then
			removeESP(other)
		end
	end
end

