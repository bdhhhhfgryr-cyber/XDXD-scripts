local function setPanel(state)
	panelOpen = state
	MainFrame.Visible = state

	if state then
		MainFrame.Position =
			UDim2.new(0.5, 32, 0.12, 0)

		MainFrame.Size =
			UDim2.fromOffset(0, 590)

		TweenService:Create(
			MainFrame,
			TweenInfo.new(
				0.28,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.Out
			),
			{
				Size = UDim2.fromOffset(280, 590)
			}
		):Play()
	else
		TweenService:Create(
			MainFrame,
			TweenInfo.new(
				0.22,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.In
			),
			{
				Size = UDim2.fromOffset(0, 590)
			}
		):Play()

		task.delay(0.23, function()
			if not panelOpen then
				MainFrame.Visible = false
			end
		end)
	end
end

OpenButton.MouseButton1Click:Connect(function()
	setPanel(not panelOpen)
end)

local draggingPanel = false
local dragStartPanel
local startPanelPosition

MainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingPanel = true
		dragStartPanel = input.Position
		startPanelPosition = MainFrame.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingPanel then
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then

			local delta =
				input.Position - dragStartPanel

			MainFrame.Position =
				UDim2.new(
					startPanelPosition.X.Scale,
					startPanelPosition.X.Offset + delta.X,
					startPanelPosition.Y.Scale,
					startPanelPosition.Y.Offset + delta.Y
				)

			OpenButton.Position =
				UDim2.new(
					startPanelPosition.X.Scale,
					startPanelPosition.X.Offset - 80,
					startPanelPosition.Y.Scale,
					startPanelPosition.Y.Offset
				)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingPanel = false
	end
end)

